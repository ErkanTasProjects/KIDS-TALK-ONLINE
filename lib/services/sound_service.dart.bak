import 'package:audioplayers/audioplayers.dart';
import 'package:flutter/foundation.dart';
import 'package:flutter/services.dart';
import 'package:flutter_tts/flutter_tts.dart';

/// Kids Talk Online - Estetik Ses ve Müzik Motoru (60 FPS & Çökme Korumalı)
class SoundService {
  static final SoundService _instance = SoundService._internal();
  factory SoundService() => _instance;
  SoundService._internal();

  final FlutterTts _tts = FlutterTts();
  final AudioPlayer _sfxPlayer = AudioPlayer();
  final AudioPlayer _voicePlayer = AudioPlayer();
  final AudioPlayer _bgmPlayer = AudioPlayer();

  bool _isInitialized = false;
  bool _isSoundEnabled = true;
  bool _isMusicEnabled = true;
  bool _isBgmPlaying = false;

  double _currentSpeechRate = 0.44; // Çocuklar için anlaşılır, akıcı hız
  double _currentPitch = 1.32;      // Neşeli, sevimli, çocuk dostu berrak ton (Erkek/kalın sesleri engeller)

  // Önceden indirilmiş stüdyo kalitesinde gerçek insan telaffuzları
  final Set<String> _cachedSpeechFiles = {
    'hello', 'good_morning', 'good_afternoon', 'how_are_you', 'goodbye',
    'mother', 'father', 'brother', 'sister', 'grandmother',
    'pencil', 'book', 'eraser', 'ruler', 'bag',
    'red', 'blue', 'green', 'yellow', 'purple',
    'one', 'two', 'three', 'four', 'five',
    'great_job', 'well_done', 'super', 'amazing', 'fantastic',
    'i_wake_up_at_7', 'i_brush_my_teeth', 'i_eat_breakfast',
    'i_go_to_school', 'i_play_in_the_park', 'i_draw', 'i_read_a_book',
    'this_is_my_bag', 'this_is_my_book', 'nice_to_meet_you',
    'see_you_later', 'have_a_nice_day', 'hi_there', 'math_is_my_favorite_subject',
    'art_is_fun', 'i_am_ten_years_old', 'i_live_in_a_city',
    'i_like_playing_football', 'i_like_english', 'my_name_is_alex',
    'i_go_to_school_by_bus', 'i_eat_breakfast_at_8', 'i_get_up_at_7',
    'i_do_my_homework_after_school', 'i_go_to_bed_at_9',
  };

  Future<void> init() async {
    if (_isInitialized) return;
    try {
      // Ses seviyeleri
      await _sfxPlayer.setVolume(0.85);
      await _voicePlayer.setVolume(1.0);
      await _bgmPlayer.setVolume(0.20);
      await _bgmPlayer.setReleaseMode(ReleaseMode.loop);

      // TTS Yapılandırması (Doğal & Akıcı)
      try {
        final dynamic engines = await _tts.getEngines;
        if (engines is List && engines.contains("com.google.android.tts")) {
          await _tts.setEngine("com.google.android.tts");
        }
      } catch (_) {}

      await _tts.awaitSpeakCompletion(false);
      await _setEnglishLanguage();
      await _tts.setSpeechRate(_currentSpeechRate);
      await _tts.setPitch(_currentPitch);
      await _tts.setVolume(1.0);

      _isInitialized = true;
      debugPrint("KidsTalk SoundService başarıyla hazırlandı.");
    } catch (e) {
      debugPrint("SoundService başlatma uyarısı: $e");
    }
  }

  void setAudioSettings({required bool soundEnabled, required bool musicEnabled}) {
    _isSoundEnabled = soundEnabled;
    _isMusicEnabled = musicEnabled;

    if (!musicEnabled && _isBgmPlaying) {
      stopBgm();
    } else if (musicEnabled && !_isBgmPlaying) {
      startBgm();
    }
  }

  // -------------------------------------------------------------------------
  // ARKA PLAN FON MÜZİĞİ (BGM)
  // -------------------------------------------------------------------------
  Future<void> startBgm() async {
    if (!_isMusicEnabled || _isBgmPlaying) return;
    try {
      await _bgmPlayer.play(AssetSource('sounds/bgm.wav'));
      _isBgmPlaying = true;
    } catch (e) {
      debugPrint("BGM başlatma hatası: $e");
    }
  }

  Future<void> stopBgm() async {
    try {
      await _bgmPlayer.stop();
      _isBgmPlaying = false;
    } catch (_) {}
  }

  Future<void> _setEnglishLanguage() async {
    try {
      final res = await _tts.setLanguage("en-US");
      if (res != 1 && res != true) {
        await _tts.setLanguage("en-GB");
      }
      // Yetişkin erkek seslerini engelle: Çocuk/kadın dostu sevimli sesi seç
      final voices = await _tts.getVoices;
      if (voices is List) {
        for (var v in voices) {
          final name = (v['name'] ?? '').toString().toLowerCase();
          final locale = (v['locale'] ?? '').toString().toLowerCase();
          if (locale.contains('en') &&
              (name.contains('female') ||
               name.contains('zira') ||
               name.contains('jenny') ||
               name.contains('samantha') ||
               name.contains('karen') ||
               name.contains('ava') ||
               name.contains('child') ||
               name.contains('girl'))) {
            await _tts.setVoice({'name': v['name'], 'locale': v['locale']});
            break;
          }
        }
      }
    } catch (_) {
      try {
        await _tts.setLanguage("en");
      } catch (_) {}
    }
  }

  String _toSafeFilename(String text) {
    return text
        .toLowerCase()
        .replaceAll(RegExp(r"[^a-zA-Z0-9]"), '_')
        .replaceAll(RegExp(r'_+'), '_')
        .replaceAll(RegExp(r'^_|_$'), '');
  }

  // -------------------------------------------------------------------------
  // DOĞAL İNGİLİZCE TELAFFUZ (Önce İnsan Sesi, Sonra Akıcı TTS)
  // -------------------------------------------------------------------------
  Future<void> speakEnglish(String text, {bool slow = false}) async {
    if (!_isSoundEnabled) return;
    try {
      playTap();
      if (!_isInitialized) await init();

      // Eski robotik/erkek sesli mp3 dosyaları yerine doğrudan berrak çocuk dostu TTS kullan
      await _voicePlayer.stop();
      await _tts.stop();
      await _setEnglishLanguage();
      await _tts.setSpeechRate(slow ? 0.28 : _currentSpeechRate);
      await _tts.setPitch(slow ? 1.20 : _currentPitch);
      await _tts.setVolume(1.0);

      final cleanText = text.replaceAll(RegExp(r'[“”"!\.\?]'), '').trim();
      if (cleanText.isNotEmpty) {
        await _tts.speak(cleanText);
      }
    } catch (e) {
      debugPrint("speakEnglish hatası: $e");
    }
  }

  // Salyangoz / Yavaşlatılmış Telaffuz (Çocukların heceleri duyması için)
  Future<void> speakEnglishSlow(String text) async {
    await speakEnglish(text, slow: true);
  }

  // Türkçe Bilgilendirme ve Teşvik Seslendirmesi
  Future<void> speakTurkish(String text) async {
    if (!_isSoundEnabled) return;
    try {
      if (!_isInitialized) await init();
      await _voicePlayer.stop();
      await _tts.stop();
      try {
        await _tts.setLanguage("tr-TR");
      } catch (_) {
        await _tts.setLanguage("tr");
      }
      await _tts.setSpeechRate(0.48);
      await _tts.setPitch(1.08);
      await _tts.setVolume(1.0);
      await _tts.speak(text);
    } catch (e) {
      debugPrint("speakTurkish hatası: $e");
    }
  }

  // -------------------------------------------------------------------------
  // TATLI OYUN SES EFEKTLERİ (SFX)
  // -------------------------------------------------------------------------
  void playPop() {
    if (!_isSoundEnabled) return;
    try {
      HapticFeedback.lightImpact();
      _sfxPlayer.stop();
      _sfxPlayer.play(AssetSource('sounds/pop.wav'));
    } catch (_) {}
  }

  void playCorrect() {
    if (!_isSoundEnabled) return;
    try {
      HapticFeedback.mediumImpact();
      _sfxPlayer.stop();
      _sfxPlayer.play(AssetSource('sounds/correct.wav'));
    } catch (_) {}
  }

  void playVictory() {
    if (!_isSoundEnabled) return;
    try {
      HapticFeedback.heavyImpact();
      _sfxPlayer.stop();
      _sfxPlayer.play(AssetSource('sounds/victory.wav'));
    } catch (_) {}
  }

  void playWrong() {
    if (!_isSoundEnabled) return;
    try {
      HapticFeedback.lightImpact();
      _sfxPlayer.stop();
      _sfxPlayer.play(AssetSource('sounds/wrong.wav'));
    } catch (_) {}
  }

  void playWhoosh() {
    if (!_isSoundEnabled) return;
    try {
      _sfxPlayer.stop();
      _sfxPlayer.play(AssetSource('sounds/whoosh.wav'));
    } catch (_) {}
  }

  void playTap() {
    if (!_isSoundEnabled) return;
    try {
      HapticFeedback.selectionClick();
      _sfxPlayer.stop();
      _sfxPlayer.play(AssetSource('sounds/tap.wav'));
    } catch (_) {}
  }

  // Hız & Ton Ayarları (Salyangoz / Roket modu)
  Future<void> setSpeechRate(double rate) async {
    _currentSpeechRate = rate.clamp(0.25, 0.9);
    try {
      await _tts.setSpeechRate(_currentSpeechRate);
    } catch (_) {}
  }

  Future<void> setPitch(double pitch) async {
    _currentPitch = pitch.clamp(0.8, 1.4);
    try {
      await _tts.setPitch(_currentPitch);
    } catch (_) {}
  }

  Future<void> stop() async {
    try {
      await _voicePlayer.stop();
      await _sfxPlayer.stop();
      await _tts.stop();
      await _bgmPlayer.stop();
    } catch (_) {}
  }
}
