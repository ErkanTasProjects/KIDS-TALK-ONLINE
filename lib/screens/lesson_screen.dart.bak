import 'dart:math';
import 'package:flutter/material.dart';
import 'package:provider/provider.dart';
import '../data/curriculum_data.dart';
import '../services/sound_service.dart';
import '../state/app_state.dart';
import '../widgets/bouncy_button.dart';
import '../widgets/kids_characters.dart';
import '../widgets/kid_progress_bar.dart';
import '../widgets/victory_dialog.dart';

class LessonScreen extends StatefulWidget {
  final ActivityItem activity;

  const LessonScreen({super.key, required this.activity});

  @override
  State<LessonScreen> createState() => _LessonScreenState();
}

class _LessonScreenState extends State<LessonScreen> with TickerProviderStateMixin {
  int _currentStepIndex = 0;
  bool _isStepCompleted = false;
  bool _showCelebration = false;
  String _characterFeedback = '';

  // Eşleştirme (Matching) durumu: Karışık görsel ve İngilizce listeler
  late List<dynamic> _shuffledVisualPairs;
  late List<dynamic> _shuffledEnglishPairs;
  String? _selectedEnglish;
  String? _selectedVisualId;
  final Set<String> _matchedPairs = {};

  // Sürükle & Bırak durumu
  final Map<int, String> _placedTargets = {};
  String? _selectedSentence;

  // Harf Çizme durumu
  final List<Offset?> _tracePoints = [];
  bool _isLetterCompleted = false;
  int _activeCheckpointIndex = 0;

  // Cümle Kurma durumu
  List<String> _builtWords = [];

  // Hafıza Oyunu durumu
  final List<int> _flippedIndices = [];
  final Set<int> _matchedIndices = {};

  // Gizli Nesne durumu
  final Set<int> _foundObjects = {};

  // Konuşma durumu
  bool _isRecording = false;

  // Balon Patlatma durumu (Gerçek Patlama & Titreme animasyonu)
  int? _poppedBalloonIndex;
  int? _wrongBalloonIndex;

  @override
  void initState() {
    super.initState();
    _characterFeedback = widget.activity.characterQuote;

    // Eşleştirme kartlarının rastgele sıralanması (Görsel ve İngilizce)
    if (widget.activity.activityType == 'matching') {
      final pairs = List.from(widget.activity.gameData['pairs'] as List<dynamic>);
      _shuffledVisualPairs = List.from(pairs)..shuffle(Random());
      _shuffledEnglishPairs = List.from(pairs)..shuffle(Random());
    } else {
      _shuffledVisualPairs = [];
      _shuffledEnglishPairs = [];
    }

    // İlk soruyu seslendir
    WidgetsBinding.instance.addPostFrameCallback((_) {
      _playInitialAudio();
    });
  }

  void _playInitialAudio() {
    if (widget.activity.activityType == 'listen_choose') {
      final questions = widget.activity.gameData['questions'] as List<dynamic>;
      final currentQ = questions[_currentStepIndex];
      SoundService().speakEnglish(currentQ['soundText'] as String);
    } else if (widget.activity.activityType == 'balloon_pop') {
      final rounds = widget.activity.gameData['rounds'] as List<dynamic>;
      final currentRound = rounds[_currentStepIndex];
      SoundService().speakEnglish(currentRound['target'] as String);
    }
  }

  void _triggerSuccess() {
    SoundService().playCorrect();
    setState(() {
      _isStepCompleted = true;
      _showCelebration = true;
      _characterFeedback = 'Awesome! You completed all challenges! 🎉';
    });

    SoundService().speakEnglish("Great job! You did it!");
    context.read<AppState>().addXp(15);
  }

  void _finishActivity() {
    SoundService().playVictory();
    context.read<AppState>().completeActivity(widget.activity.id, 3);
    VictoryCelebrationDialog.show(
      context: context,
      characterName: widget.activity.characterName,
      activityTitle: widget.activity.title,
      stars: 3,
      xpEarned: 45,
      onContinue: () {
        Navigator.of(context).pop();
      },
    );
  }

  double _getProgress() {
    if (_isStepCompleted) return 1.0;
    switch (widget.activity.activityType) {
      case 'matching':
        final pairs = widget.activity.gameData['pairs'] as List<dynamic>;
        return (_matchedPairs.length / pairs.length).clamp(0.08, 1.0);
      case 'drag_drop':
      case 'schedule_drag':
        final targets = widget.activity.gameData['targets'] as List<dynamic>;
        return (_placedTargets.length / targets.length).clamp(0.08, 1.0);
      case 'memory':
        final cards = widget.activity.gameData['cards'] as List<dynamic>;
        return (_matchedIndices.length / cards.length).clamp(0.08, 1.0);
      case 'hidden_object':
        final objects = widget.activity.gameData['objects'] as List<dynamic>;
        return (_foundObjects.length / objects.length).clamp(0.08, 1.0);
      case 'trace':
        final letters = widget.activity.gameData['letters'] as List<dynamic>;
        return ((_currentStepIndex + (_isLetterCompleted ? 1 : 0)) / letters.length).clamp(0.08, 1.0);
      default:
        int total = 5;
        if (widget.activity.gameData['questions'] != null) {
          total = (widget.activity.gameData['questions'] as List).length;
        } else if (widget.activity.gameData['rounds'] != null) {
          total = (widget.activity.gameData['rounds'] as List).length;
        } else if (widget.activity.gameData['sentences'] != null) {
          total = (widget.activity.gameData['sentences'] as List).length;
        } else if (widget.activity.gameData['prompts'] != null) {
          total = (widget.activity.gameData['prompts'] as List).length;
        }
        return ((_currentStepIndex + 0.1) / total).clamp(0.08, 1.0);
    }
  }

  @override
  Widget build(BuildContext context) {
    final hearts = context.watch<AppState>().hearts;

    return CelebrationOverlay(
      showCelebration: _showCelebration,
      child: Scaffold(
        backgroundColor: const Color(0xFFFBF9FE),
        appBar: AppBar(
          backgroundColor: Colors.transparent,
          elevation: 0,
          leading: Padding(
            padding: const EdgeInsets.only(left: 12),
            child: GestureDetector(
              onTap: () {
                SoundService().stop();
                Navigator.of(context).pop();
              },
              child: Container(
                width: 38,
                height: 38,
                decoration: BoxDecoration(
                  color: Colors.white,
                  shape: BoxShape.circle,
                  boxShadow: [
                    BoxShadow(
                      color: Colors.black.withValues(alpha: 0.08),
                      blurRadius: 6,
                      offset: const Offset(0, 2),
                    ),
                  ],
                ),
                child: const Icon(Icons.close_rounded, color: Color(0xFF2D3748), size: 22),
              ),
            ),
          ),
          title: ClipRRect(
            borderRadius: BorderRadius.circular(10),
            child: SizedBox(
              height: 12,
              child: LinearProgressIndicator(
                value: _getProgress(),
                backgroundColor: const Color(0xFFE8E5F5),
                valueColor: const AlwaysStoppedAnimation<Color>(Color(0xFF6C5CE7)),
              ),
            ),
          ),
          centerTitle: true,
          actions: [
            Padding(
              padding: const EdgeInsets.only(right: 16),
              child: Row(
                children: const [
                  Text("⭐", style: TextStyle(fontSize: 14)),
                  SizedBox(width: 2),
                  Text("⭐", style: TextStyle(fontSize: 14)),
                  SizedBox(width: 2),
                  Text("⭐", style: TextStyle(fontSize: 14)),
                ],
              ),
            ),
          ],
        ),
        body: SafeArea(
          child: Column(
            children: [
              const SizedBox(height: 6),
              // Maskot Rehberlik Baloncuğu (Gigi)
              CharacterDialogueBox(
                characterName: widget.activity.characterName,
                message: _characterFeedback,
                onCharacterTap: () {
                  SoundService().speakEnglish(_characterFeedback);
                },
              ),

              // Ana Oyun Alanı
              Expanded(
                child: Padding(
                  padding: const EdgeInsets.symmetric(horizontal: 16.0),
                  child: _buildActivityGame(),
                ),
              ),

              // Devam Butonu
              if (_isStepCompleted)
                Container(
                  padding: const EdgeInsets.all(16),
                  decoration: BoxDecoration(
                    color: Colors.white,
                    border: Border(top: BorderSide(color: Colors.grey.shade200, width: 2)),
                  ),
                  child: BouncyButton(
                    text: 'NEXT MISSION 🌟',
                    color: const Color(0xFF4CAF50),
                    shadowColor: const Color(0xFF2E7D32),
                    isActive: true,
                    onPressed: _finishActivity,
                  ),
                ),
            ],
          ),
        ),
      ),
    );
  }

  Widget _buildActivityGame() {
    switch (widget.activity.activityType) {
      case 'matching':
        return _buildMatchingGame();
      case 'drag_drop':
      case 'schedule_drag':
        return _buildDragDropGame();
      case 'trace':
        return _buildTraceGame();
      case 'listen_choose':
        return _buildListenChooseGame();
      case 'balloon_pop':
        return _buildBalloonPopGame();
      case 'sentence_builder':
        return _buildSentenceBuilderGame();
      case 'memory':
        return _buildMemoryGame();
      case 'hidden_object':
        return _buildHiddenObjectGame();
      case 'fill_blank':
        return _buildFillBlankGame();
      case 'speak_record':
        return _buildSpeakRecordGame();
      default:
        return const Center(child: Text("Game Ready"));
    }
  }

  // -------------------------------------------------------------------------
  // 1. EŞLEŞTİRME (MATCHING): OYUNLAŞTIRILMIŞ MACERA PARKURU ("Zürafayı Yaprağa / Hedefe Ulaştır")
  // Hiçbir Türkçe çeviri içermez, %100 Görsel + İngilizce Telaffuz!
  // -------------------------------------------------------------------------
  Widget _buildMatchingGame() {
    final pairs = widget.activity.gameData['pairs'] as List<dynamic>;
    final totalPairs = pairs.length;
    final matchedCount = _matchedPairs.length;
    final targetGoal = widget.activity.gameData['targetGoal'] as String? ?? 'Golden Leaves 🌿';

    return Column(
      children: [
        // 1. OYUNLAŞTIRILMIŞ MACERA PARKURU (İnteraktif Taşlar & Hedef)
        Container(
          margin: const EdgeInsets.only(bottom: 14),
          padding: const EdgeInsets.symmetric(horizontal: 16, vertical: 12),
          decoration: BoxDecoration(
            gradient: const LinearGradient(
              colors: [Color(0xFFFFF8E1), Color(0xFFFFECB3), Color(0xFFFFE082)],
              begin: Alignment.topLeft,
              end: Alignment.bottomRight,
            ),
            borderRadius: BorderRadius.circular(22),
            border: Border.all(color: const Color(0xFFFFCA28), width: 2),
            boxShadow: [
              BoxShadow(
                color: Colors.amber.withValues(alpha: 0.22),
                blurRadius: 10,
                offset: const Offset(0, 4),
              )
            ],
          ),
          child: Column(
            children: [
              Row(
                mainAxisAlignment: MainAxisAlignment.spaceBetween,
                children: [
                  Row(
                    children: [
                      const Text("🗺️", style: TextStyle(fontSize: 16)),
                      const SizedBox(width: 6),
                      Text(
                        "Help Gigi reach the goal! ($matchedCount / $totalPairs)",
                        style: const TextStyle(
                          fontSize: 13,
                          fontWeight: FontWeight.w900,
                          color: Color(0xFFE65100),
                        ),
                      ),
                    ],
                  ),
                  Container(
                    padding: const EdgeInsets.symmetric(horizontal: 10, vertical: 4),
                    decoration: BoxDecoration(
                      color: Colors.white,
                      borderRadius: BorderRadius.circular(12),
                      border: Border.all(color: Colors.orange.shade300),
                    ),
                    child: Text(
                      matchedCount == totalPairs ? "REACHED! 🏆" : "STEP ${matchedCount + 1}",
                      style: TextStyle(
                        fontSize: 11,
                        fontWeight: FontWeight.w900,
                        color: matchedCount == totalPairs ? Colors.green.shade800 : Colors.orange.shade800,
                      ),
                    ),
                  ),
                ],
              ),
              const SizedBox(height: 12),

              // İnteraktif Harita / Taşlar Parkuru
              Stack(
                alignment: Alignment.centerLeft,
                children: [
                  // Zemin Yol Çizgisi
                  Container(
                    height: 10,
                    margin: const EdgeInsets.symmetric(horizontal: 18),
                    decoration: BoxDecoration(
                      color: Colors.white,
                      borderRadius: BorderRadius.circular(5),
                      boxShadow: [
                        BoxShadow(
                          color: Colors.black.withValues(alpha: 0.05),
                          blurRadius: 4,
                          offset: const Offset(0, 2),
                        )
                      ],
                    ),
                  ),

                  // Tamamlanan Renkli Yol Çizgisi
                  FractionallySizedBox(
                    widthFactor: totalPairs > 0 ? (matchedCount / totalPairs).clamp(0.0, 1.0) : 0.0,
                    child: Container(
                      height: 10,
                      margin: const EdgeInsets.symmetric(horizontal: 18),
                      decoration: BoxDecoration(
                        gradient: const LinearGradient(colors: [Colors.orange, Colors.green]),
                        borderRadius: BorderRadius.circular(5),
                      ),
                    ),
                  ),

                  // Parkur Adımları (Stepping Stones)
                  Row(
                    mainAxisAlignment: MainAxisAlignment.spaceBetween,
                    children: [
                      for (int i = 0; i <= totalPairs; i++)
                        _buildSteppingStone(
                          stepIndex: i,
                          totalPairs: totalPairs,
                          currentMatched: matchedCount,
                          targetGoal: targetGoal,
                        ),
                    ],
                  ),
                ],
              ),
            ],
          ),
        ),

        // 2. GÖRSEL VE İNGİLİZCE EŞLEŞTİRME OYUN ALANI (Çift Kolonlu Test Değil, İnteraktif Oyun Alanı)
        Expanded(
          child: Column(
            crossAxisAlignment: CrossAxisAlignment.stretch,
            children: [
              // Adım 1: Görsel Kartlar Bölümü (Görsel Seçimi)
              Container(
                padding: const EdgeInsets.symmetric(horizontal: 12, vertical: 8),
                decoration: BoxDecoration(
                  color: Colors.amber.shade50,
                  borderRadius: BorderRadius.circular(16),
                  border: Border.all(color: Colors.amber.shade200),
                ),
                child: Row(
                  children: [
                    const Text("🎨", style: TextStyle(fontSize: 16)),
                    const SizedBox(width: 6),
                    Text(
                      _selectedVisualId == null ? "Step 1: Pick a Picture" : "Step 2: Now tap its English Sound below!",
                      style: const TextStyle(
                        fontSize: 12,
                        fontWeight: FontWeight.w900,
                        color: Color(0xFFE65100),
                      ),
                    ),
                  ],
                ),
              ),
              const SizedBox(height: 8),

              // Görsel Kartlar (Büyük 3D Rozetler)
              SizedBox(
                height: 86,
                child: ListView.separated(
                  scrollDirection: Axis.horizontal,
                  physics: const BouncingScrollPhysics(),
                  itemCount: _shuffledVisualPairs.length,
                  separatorBuilder: (_, __) => const SizedBox(width: 8),
                  itemBuilder: (context, index) {
                    final pair = _shuffledVisualPairs[index];
                    final pairId = pair['id'] as String;
                    final icon = pair['icon'] as String;
                    final label = pair['label'] as String? ?? '';
                    final isMatched = _matchedPairs.contains(pair['english']);
                    final isSelected = _selectedVisualId == pairId;

                    return GestureDetector(
                      onTap: isMatched
                          ? null
                          : () {
                              SoundService().playTap();
                              _handleVisualTap(pairId, pair['english'] as String);
                            },
                      child: AnimatedContainer(
                        duration: const Duration(milliseconds: 220),
                        width: 96,
                        padding: const EdgeInsets.all(8),
                        decoration: BoxDecoration(
                          color: isMatched
                              ? const Color(0xFFE8F5E9)
                              : (isSelected ? const Color(0xFFFFF9C4) : Colors.white),
                          borderRadius: BorderRadius.circular(20),
                          border: Border.all(
                            color: isMatched
                                ? Colors.green
                                : (isSelected ? Colors.amber.shade700 : Colors.amber.shade200),
                            width: isSelected ? 3.0 : 2.0,
                          ),
                          boxShadow: [
                            BoxShadow(
                              color: isSelected
                                  ? Colors.amber.withValues(alpha: 0.35)
                                  : Colors.black.withValues(alpha: 0.05),
                              blurRadius: isSelected ? 8 : 4,
                              offset: const Offset(0, 3),
                            )
                          ],
                        ),
                        child: Column(
                          mainAxisAlignment: MainAxisAlignment.center,
                          children: [
                            Text(icon, style: const TextStyle(fontSize: 32)),
                            const SizedBox(height: 4),
                            Text(
                              isMatched ? "✓ Done" : label,
                              maxLines: 1,
                              overflow: TextOverflow.ellipsis,
                              style: TextStyle(
                                fontSize: 10,
                                fontWeight: FontWeight.bold,
                                color: isMatched ? Colors.green.shade800 : Colors.brown.shade800,
                              ),
                            ),
                          ],
                        ),
                      ),
                    );
                  },
                ),
              ),
              const SizedBox(height: 12),

              // Adım 2: İngilizce Sesli Kelime Baloncukları
              Expanded(
                child: ListView.separated(
                  physics: const BouncingScrollPhysics(),
                  itemCount: _shuffledEnglishPairs.length,
                  separatorBuilder: (_, __) => const SizedBox(height: 8),
                  itemBuilder: (context, index) {
                    final pair = _shuffledEnglishPairs[index];
                    final eng = pair['english'] as String;
                    final pairId = pair['id'] as String;
                    final isMatched = _matchedPairs.contains(eng);
                    final isSelected = _selectedEnglish == eng;

                    return GestureDetector(
                      onTap: isMatched
                          ? () => SoundService().speakEnglish(eng)
                          : () {
                              SoundService().speakEnglish(eng);
                              _handleEnglishTap(eng, pairId);
                            },
                      child: AnimatedContainer(
                        duration: const Duration(milliseconds: 220),
                        padding: const EdgeInsets.symmetric(vertical: 12, horizontal: 16),
                        decoration: BoxDecoration(
                          color: isMatched
                              ? const Color(0xFFE8F5E9)
                              : (isSelected ? const Color(0xFFEDE7F6) : Colors.white),
                          borderRadius: BorderRadius.circular(20),
                          border: Border.all(
                            color: isMatched
                                ? Colors.green
                                : (isSelected ? const Color(0xFF7B1FA2) : Colors.purple.shade100),
                            width: isSelected ? 3.0 : 1.5,
                          ),
                          boxShadow: [
                            BoxShadow(
                              color: isSelected
                                  ? Colors.purple.withValues(alpha: 0.25)
                                  : Colors.black.withValues(alpha: 0.04),
                              blurRadius: isSelected ? 8 : 4,
                              offset: const Offset(0, 2),
                            )
                          ],
                        ),
                        child: Row(
                          children: [
                            Container(
                              padding: const EdgeInsets.all(8),
                              decoration: BoxDecoration(
                                color: isMatched ? Colors.green.shade100 : Colors.purple.shade50,
                                shape: BoxShape.circle,
                              ),
                              child: Icon(
                                isMatched ? Icons.check_circle_rounded : Icons.volume_up_rounded,
                                color: isMatched ? Colors.green.shade800 : const Color(0xFF7B1FA2),
                                size: 20,
                              ),
                            ),
                            const SizedBox(width: 14),
                            Expanded(
                              child: Text(
                                eng,
                                style: TextStyle(
                                  fontSize: 16,
                                  fontWeight: FontWeight.w900,
                                  color: isMatched ? Colors.green.shade900 : const Color(0xFF311B92),
                                ),
                              ),
                            ),
                            if (isMatched)
                              Container(
                                padding: const EdgeInsets.symmetric(horizontal: 10, vertical: 4),
                                decoration: BoxDecoration(
                                  color: Colors.green.shade100,
                                  borderRadius: BorderRadius.circular(12),
                                ),
                                child: const Text(
                                  "MATCHED! ⭐",
                                  style: TextStyle(
                                    fontSize: 11,
                                    fontWeight: FontWeight.w900,
                                    color: Colors.green,
                                  ),
                                ),
                              )
                            else
                              const Icon(Icons.touch_app_rounded, color: Colors.purple, size: 18),
                          ],
                        ),
                      ),
                    );
                  },
                ),
              ),
            ],
          ),
        ),
      ],
    );
  }

  Widget _buildSteppingStone({
    required int stepIndex,
    required int totalPairs,
    required int currentMatched,
    required String targetGoal,
  }) {
    final bool isMascotHere = (stepIndex == currentMatched);
    final bool isGoal = (stepIndex == totalPairs);
    final bool isPassed = (stepIndex < currentMatched);

    if (isGoal) {
      // Hedef Noktası (Peynir, Taze Yapraklar, Hazine vb.)
      return Container(
        width: 44,
        height: 44,
        decoration: BoxDecoration(
          color: currentMatched == totalPairs ? Colors.amber.shade300 : Colors.white,
          shape: BoxShape.circle,
          border: Border.all(
            color: currentMatched == totalPairs ? Colors.green : Colors.amber.shade400,
            width: 2.5,
          ),
          boxShadow: [
            BoxShadow(
              color: Colors.amber.withValues(alpha: 0.3),
              blurRadius: 6,
              offset: const Offset(0, 2),
            )
          ],
        ),
        child: Center(
          child: Text(
            currentMatched == totalPairs ? "🏆" : targetGoal.split(' ').last,
            style: const TextStyle(fontSize: 22),
          ),
        ),
      );
    }

    if (isMascotHere) {
      // Maskotumuz (Gigi Zürafa) şu an bu taşta!
      return AnimatedContainer(
        duration: const Duration(milliseconds: 300),
        curve: Curves.elasticOut,
        width: 44,
        height: 44,
        decoration: BoxDecoration(
          color: Colors.amber.shade100,
          shape: BoxShape.circle,
          border: Border.all(color: Colors.orange, width: 3),
          boxShadow: [
            BoxShadow(
              color: Colors.orange.withValues(alpha: 0.4),
              blurRadius: 8,
              offset: const Offset(0, 3),
            )
          ],
        ),
        padding: const EdgeInsets.all(2),
        child: ClipOval(
          child: Image.asset(
            'assets/images/user_mascot_transparent.png',
            fit: BoxFit.contain,
            errorBuilder: (_, __, ___) => const Center(
              child: Text("🦒", style: TextStyle(fontSize: 22)),
            ),
          ),
        ),
      );
    }

    // Geçilen veya henüz gelinmeyen taş
    return Container(
      width: 32,
      height: 32,
      decoration: BoxDecoration(
        color: isPassed ? Colors.green.shade100 : Colors.white,
        shape: BoxShape.circle,
        border: Border.all(
          color: isPassed ? Colors.green : Colors.grey.shade300,
          width: 2,
        ),
      ),
      child: Center(
        child: Text(
          isPassed ? "⭐" : "${stepIndex + 1}",
          style: TextStyle(
            fontSize: isPassed ? 14 : 12,
            fontWeight: FontWeight.bold,
            color: isPassed ? Colors.green.shade800 : Colors.grey.shade600,
          ),
        ),
      ),
    );
  }

  void _handleVisualTap(String visualId, String associatedEnglish) {
    setState(() {
      _selectedVisualId = visualId;
      _checkMatchingSolution();
    });
  }

  void _handleEnglishTap(String english, String associatedId) {
    setState(() {
      _selectedEnglish = english;
      _checkMatchingSolution();
    });
  }

  void _checkMatchingSolution() {
    if (_selectedVisualId != null && _selectedEnglish != null) {
      final pairs = widget.activity.gameData['pairs'] as List<dynamic>;
      final targetPair = pairs.firstWhere((p) => p['id'] == _selectedVisualId);

      if (targetPair['english'] == _selectedEnglish) {
        SoundService().playCorrect();
        _matchedPairs.add(_selectedEnglish!);
        _characterFeedback = "Awesome! Step ${_matchedPairs.length} completed! ⭐";

        if (_matchedPairs.length == pairs.length) {
          _triggerSuccess();
        }
      } else {
        SoundService().playWrong();
        SoundService().speakEnglish("Try again!");
        _characterFeedback = "Try again! You can do it! 💪";
        context.read<AppState>().useHeart();
      }

      _selectedVisualId = null;
      _selectedEnglish = null;
    }
  }

  // -------------------------------------------------------------------------
  // 2. GERÇEK SÜRÜKLE & BIRAK (DRAGGABLE & DRAGTARGET)
  // -------------------------------------------------------------------------
  Widget _buildDragDropGame() {
    final targets = widget.activity.gameData['targets'] as List<dynamic>;

    return Column(
      children: [
        const Text(
          "Drag each card to the matching box! 👆",
          style: TextStyle(fontSize: 13, fontWeight: FontWeight.bold, color: Colors.purple),
        ),
        const SizedBox(height: 8),

        // Hedef Kutular (DragTarget)
        Expanded(
          child: ListView.separated(
            padding: const EdgeInsets.symmetric(vertical: 4),
            itemCount: targets.length,
            separatorBuilder: (_, __) => const SizedBox(height: 10),
            itemBuilder: (context, index) {
              final target = targets[index];
              final isPlaced = _placedTargets.containsKey(index);

              return DragTarget<String>(
                onWillAcceptWithDetails: (details) => !isPlaced,
                onAcceptWithDetails: (details) {
                  final droppedSentence = details.data;
                  if (droppedSentence == target['sentence']) {
                    SoundService().playCorrect();
                    setState(() {
                      _placedTargets[index] = droppedSentence;
                      _characterFeedback = 'Awesome! Perfect match! 👏';
                    });
                    SoundService().speakEnglish(droppedSentence);
                    if (_placedTargets.length == targets.length) {
                      _triggerSuccess();
                    }
                  } else {
                    SoundService().playWrong();
                    setState(() {
                      _characterFeedback = 'Not this box, try again! 🤔';
                    });
                    context.read<AppState>().useHeart();
                  }
                },
                builder: (context, candidateData, rejectedData) {
                  final isHovered = candidateData.isNotEmpty;

                  return GestureDetector(
                    onTap: () {
                      // Tıklama desteği de korundu
                      if (_selectedSentence != null && !isPlaced) {
                        if (_selectedSentence == target['sentence']) {
                          setState(() {
                            _placedTargets[index] = _selectedSentence!;
                            _selectedSentence = null;
                            _characterFeedback = 'Awesome match! You did it! 👏';
                          });
                          SoundService().speakEnglish(target['sentence']);
                          if (_placedTargets.length == targets.length) {
                            _triggerSuccess();
                          }
                        } else {
                          setState(() {
                            _characterFeedback = 'Try a different box! 🤔';
                          });
                          context.read<AppState>().useHeart();
                        }
                      } else if (isPlaced) {
                        SoundService().speakEnglish(_placedTargets[index]!);
                      }
                    },
                    child: AnimatedContainer(
                      duration: const Duration(milliseconds: 200),
                      padding: const EdgeInsets.all(12),
                      decoration: BoxDecoration(
                        color: isPlaced
                            ? const Color(0xFFE8F5E9)
                            : (isHovered ? const Color(0xFFFFF9C4) : Colors.white),
                        borderRadius: BorderRadius.circular(18),
                        border: Border.all(
                          color: isPlaced
                              ? Colors.green
                              : (isHovered ? Colors.amber.shade700 : Colors.grey.shade300),
                          width: isHovered ? 3.0 : 2.0,
                        ),
                      ),
                      child: Row(
                        children: [
                          Container(
                            padding: const EdgeInsets.all(8),
                            decoration: BoxDecoration(
                              color: Colors.purple.shade50,
                              shape: BoxShape.circle,
                            ),
                            child: Text(target['icon'], style: const TextStyle(fontSize: 22)),
                          ),
                          const SizedBox(width: 12),
                          Expanded(
                            child: Column(
                              crossAxisAlignment: CrossAxisAlignment.start,
                              children: [
                                Text(
                                  isPlaced
                                      ? _placedTargets[index]!
                                      : (isHovered ? "👉 Drop Here!" : "👉 Drag & Drop or Tap"),
                                  style: TextStyle(
                                    fontSize: 15,
                                    fontWeight: FontWeight.w900,
                                    color: isPlaced
                                        ? Colors.green.shade900
                                        : (isHovered ? Colors.amber.shade900 : Colors.purple.shade300),
                                  ),
                                ),
                              ],
                            ),
                          ),
                          if (isPlaced)
                            const Icon(Icons.check_circle_rounded, color: Colors.green, size: 24),
                        ],
                      ),
                    ),
                  );
                },
              );
            },
          ),
        ),

        // Sürüklenebilir Cümle Kartları Havuzu (Draggable)
        Container(
          padding: const EdgeInsets.all(10),
          decoration: BoxDecoration(
            color: Colors.white,
            borderRadius: BorderRadius.circular(20),
            border: Border.all(color: Colors.grey.shade200, width: 2),
          ),
          child: Wrap(
            spacing: 8,
            runSpacing: 8,
            children: targets.map((target) {
              final sentence = target['sentence'] as String;
              final isUsed = _placedTargets.containsValue(sentence);
              final isSelected = _selectedSentence == sentence;

              if (isUsed) return const SizedBox.shrink();

              final cardWidget = Container(
                padding: const EdgeInsets.symmetric(horizontal: 14, vertical: 10),
                decoration: BoxDecoration(
                  color: isSelected ? Colors.amber.shade300 : const Color(0xFFF3E5F5),
                  borderRadius: BorderRadius.circular(14),
                  border: Border.all(
                    color: isSelected ? Colors.amber.shade700 : Colors.purple.shade200,
                    width: 2,
                  ),
                  boxShadow: [
                    BoxShadow(color: Colors.black.withValues(alpha: 0.05), blurRadius: 4, offset: const Offset(0, 2))
                  ],
                ),
                child: Row(
                  mainAxisSize: MainAxisSize.min,
                  children: [
                    const Icon(Icons.drag_indicator_rounded, size: 18, color: Colors.purple),
                    const SizedBox(width: 4),
                    Text(
                      sentence,
                      style: TextStyle(
                        fontSize: 14,
                        fontWeight: FontWeight.w900,
                        color: isSelected ? Colors.black87 : const Color(0xFF4A148C),
                      ),
                    ),
                  ],
                ),
              );

              return Draggable<String>(
                data: sentence,
                onDragStarted: () {
                  SoundService().speakEnglish(sentence);
                },
                feedback: Material(
                  color: Colors.transparent,
                  child: Transform.scale(scale: 1.08, child: cardWidget),
                ),
                childWhenDragging: Opacity(opacity: 0.35, child: cardWidget),
                child: GestureDetector(
                  onTap: () {
                    SoundService().speakEnglish(sentence);
                    setState(() => _selectedSentence = sentence);
                  },
                  child: cardWidget,
                ),
              );
            }).toList(),
          ),
        ),
      ],
    );
  }

  // -------------------------------------------------------------------------
  // 3. DİNLENENİ SEÇ (LISTEN & CHOOSE): REFERANS TASARIM (2 ÜST + 1 ALT DÜZENİ)
  // -------------------------------------------------------------------------
  Widget _buildListenChooseGame() {
    final questions = widget.activity.gameData['questions'] as List<dynamic>;
    final currentQ = questions[_currentStepIndex];
    final options = currentQ['options'] as List<dynamic>;

    Widget buildOptionCard(dynamic opt, {double width = 145, double height = 135}) {
      final name = opt['name'] as String;
      final icon = opt['icon'] as String;

      return GestureDetector(
        onTap: () {
          SoundService().speakEnglish(name);
          setState(() {
            if (name == currentQ['target']) {
              SoundService().playCorrect();
              _characterFeedback = "Great choice! Very sharp! 🎯";
              SoundService().speakEnglish("Great job!");
              if (_currentStepIndex < questions.length - 1) {
                _currentStepIndex++;
                _playInitialAudio();
              } else {
                _triggerSuccess();
              }
            } else {
              SoundService().playWrong();
              _characterFeedback = "Listen again and try another card! 🎧";
              context.read<AppState>().useHeart();
            }
          });
        },
        child: Container(
          width: width,
          height: height,
          decoration: BoxDecoration(
            color: Colors.white,
            borderRadius: BorderRadius.circular(24),
            border: Border.all(color: const Color(0xFFECECF2), width: 2),
            boxShadow: [
              BoxShadow(
                color: Colors.black.withValues(alpha: 0.05),
                blurRadius: 10,
                offset: const Offset(0, 4),
              ),
            ],
          ),
          child: Column(
            mainAxisAlignment: MainAxisAlignment.center,
            children: [
              Text(icon, style: const TextStyle(fontSize: 48)),
              const SizedBox(height: 10),
              Container(
                padding: const EdgeInsets.symmetric(horizontal: 14, vertical: 4),
                decoration: BoxDecoration(
                  color: const Color(0xFFFFF3E0),
                  borderRadius: BorderRadius.circular(12),
                ),
                child: Text(
                  name,
                  style: const TextStyle(
                    fontSize: 13,
                    fontWeight: FontWeight.w900,
                    color: Color(0xFF3E2723),
                  ),
                ),
              ),
            ],
          ),
        ),
      );
    }

    return Column(
      children: [
        const SizedBox(height: 16),
        // Ses Butonları (Büyük Kırmızı Hoparlör + Sarı Hız Göstergesi)
        Row(
          mainAxisAlignment: MainAxisAlignment.center,
          children: [
            // Büyük Kırmızı Hoparlör Butonu
            GestureDetector(
              onTap: () {
                SoundService().speakEnglish(currentQ['soundText'] as String);
              },
              child: Container(
                width: 76,
                height: 76,
                decoration: BoxDecoration(
                  color: const Color(0xFFFF5252),
                  shape: BoxShape.circle,
                  boxShadow: [
                    BoxShadow(
                      color: const Color(0xFFFF5252).withValues(alpha: 0.38),
                      blurRadius: 14,
                      offset: const Offset(0, 5),
                    ),
                  ],
                ),
                child: const Icon(Icons.volume_up_rounded, color: Colors.white, size: 38),
              ),
            ),
            const SizedBox(width: 14),
            // Küçük Sarı Hız / Salyangoz Butonu
            GestureDetector(
              onTap: () {
                SoundService().speakEnglishSlow(currentQ['soundText'] as String);
              },
              child: Container(
                width: 48,
                height: 48,
                decoration: BoxDecoration(
                  color: const Color(0xFFFFC107),
                  shape: BoxShape.circle,
                  boxShadow: [
                    BoxShadow(
                      color: const Color(0xFFFFC107).withValues(alpha: 0.35),
                      blurRadius: 8,
                      offset: const Offset(0, 3),
                    ),
                  ],
                ),
                child: const Icon(Icons.speed_rounded, color: Color(0xFF4E342E), size: 24),
              ),
            ),
          ],
        ),
        const SizedBox(height: 24),

        // Referans Uygulamadaki 2 Üst + 1 Alt Kart Düzeni
        if (options.length == 3) ...[
          Row(
            mainAxisAlignment: MainAxisAlignment.center,
            children: [
              buildOptionCard(options[0]),
              const SizedBox(width: 16),
              buildOptionCard(options[1]),
            ],
          ),
          const SizedBox(height: 16),
          Row(
            mainAxisAlignment: MainAxisAlignment.center,
            children: [
              buildOptionCard(options[2]),
            ],
          ),
        ] else ...[
          Wrap(
            spacing: 16,
            runSpacing: 16,
            alignment: WrapAlignment.center,
            children: options.map((opt) => buildOptionCard(opt)).toList(),
          ),
        ],
      ],
    );
  }

  // -------------------------------------------------------------------------
  // 4. BALON PATLATMA (BALLOON POP) - Gerçek Pop & Patlama Efektli
  // -------------------------------------------------------------------------
  Widget _buildBalloonPopGame() {
    final rounds = widget.activity.gameData['rounds'] as List<dynamic>;
    final currentRound = rounds[_currentStepIndex];
    final options = currentRound['options'] as List<dynamic>;
    final balloonColors = [const Color(0xFFFF3366), const Color(0xFF9C27B0), const Color(0xFF00B0FF)];

    return Column(
      children: [
        // Ses Dinleme ve Hedef Kartı (100% İngilizce)
        Container(
          padding: const EdgeInsets.symmetric(horizontal: 16, vertical: 12),
          decoration: BoxDecoration(
            gradient: LinearGradient(
              colors: [Colors.lightBlue.shade50, Colors.purple.shade50],
              begin: Alignment.topLeft,
              end: Alignment.bottomRight,
            ),
            borderRadius: BorderRadius.circular(20),
            border: Border.all(color: Colors.purple.shade200, width: 2),
            boxShadow: [
              BoxShadow(
                color: Colors.purple.withValues(alpha: 0.08),
                blurRadius: 8,
                offset: const Offset(0, 3),
              ),
            ],
          ),
          child: Row(
            children: [
              GestureDetector(
                onTap: () {
                  SoundService().speakEnglish(currentRound['target'] as String);
                },
                child: Container(
                  width: 52,
                  height: 52,
                  decoration: BoxDecoration(
                    color: const Color(0xFF7B1FA2),
                    shape: BoxShape.circle,
                    boxShadow: [
                      BoxShadow(
                        color: Colors.purple.withValues(alpha: 0.35),
                        blurRadius: 8,
                        offset: const Offset(0, 3),
                      )
                    ],
                  ),
                  child: const Center(
                    child: Icon(Icons.volume_up_rounded, color: Colors.white, size: 28),
                  ),
                ),
              ),
              const SizedBox(width: 14),
              Expanded(
                child: Column(
                  crossAxisAlignment: CrossAxisAlignment.start,
                  children: [
                    const Text(
                      "Listen & Pop the Balloon! 🎈",
                      style: TextStyle(fontSize: 13, fontWeight: FontWeight.bold, color: Color(0xFF7B1FA2)),
                    ),
                    const SizedBox(height: 2),
                    Text(
                      currentRound['target'] as String,
                      style: const TextStyle(fontSize: 18, fontWeight: FontWeight.w900, color: Color(0xFF263238)),
                    ),
                  ],
                ),
              ),
              Container(
                padding: const EdgeInsets.symmetric(horizontal: 8, vertical: 4),
                decoration: BoxDecoration(
                  color: Colors.white,
                  borderRadius: BorderRadius.circular(10),
                  border: Border.all(color: Colors.purple.shade200),
                ),
                child: Text(
                  "${_currentStepIndex + 1} / ${rounds.length}",
                  style: const TextStyle(fontWeight: FontWeight.w900, fontSize: 12, color: Color(0xFF7B1FA2)),
                ),
              ),
            ],
          ),
        ),
        const SizedBox(height: 20),

        // Uçuşan ve Patlayan Balonlar
        Expanded(
          child: Row(
            mainAxisAlignment: MainAxisAlignment.spaceEvenly,
            crossAxisAlignment: CrossAxisAlignment.center,
            children: List.generate(options.length, (index) {
              final opt = options[index] as String;
              final color = balloonColors[index % balloonColors.length];
              final isTarget = opt == currentRound['target'];
              final isPopped = _poppedBalloonIndex == index;
              final isWobbling = _wrongBalloonIndex == index;

              if (isPopped) {
                // Balon Patlama Efekti (Burst & Stars)
                return Expanded(
                  child: Center(
                    child: AnimatedScale(
                      scale: 1.4,
                      duration: const Duration(milliseconds: 250),
                      child: Column(
                        mainAxisSize: MainAxisSize.min,
                        children: const [
                          Text("💥", style: TextStyle(fontSize: 54)),
                          SizedBox(height: 4),
                          Text("POP! ⭐", style: TextStyle(fontWeight: FontWeight.w900, color: Colors.orange, fontSize: 16)),
                        ],
                      ),
                    ),
                  ),
                );
              }

              return Expanded(
                child: AnimatedContainer(
                  duration: const Duration(milliseconds: 180),
                  transform: Matrix4.translationValues(
                    isWobbling ? (index.isEven ? 8.0 : -8.0) : 0.0,
                    (index == 1 ? -12.0 : 6.0), // Doğal gökyüzü süzülme hizası
                    0,
                  ),
                  child: GestureDetector(
                    onTap: _poppedBalloonIndex != null
                        ? null
                        : () {
                            if (isTarget) {
                              SoundService().playPop();
                              setState(() {
                                _poppedBalloonIndex = index;
                                _characterFeedback = "POP! 🎈 Awesome job! You popped the right one! ⭐";
                              });
                              SoundService().speakEnglish("Pop! $opt!");

                              Future.delayed(const Duration(milliseconds: 650), () {
                                if (mounted) {
                                  setState(() {
                                    _poppedBalloonIndex = null;
                                    _wrongBalloonIndex = null;
                                    if (_currentStepIndex < rounds.length - 1) {
                                      _currentStepIndex++;
                                      _playInitialAudio();
                                    } else {
                                      _triggerSuccess();
                                    }
                                  });
                                }
                              });
                            } else {
                              SoundService().playWrong();
                              setState(() {
                                _wrongBalloonIndex = index;
                                _characterFeedback = "Oops! Listen carefully and pop the right balloon! 🎈";
                              });
                              context.read<AppState>().useHeart();
                              Future.delayed(const Duration(milliseconds: 400), () {
                                if (mounted) setState(() => _wrongBalloonIndex = null);
                              });
                            }
                          },
                    child: Column(
                      mainAxisAlignment: MainAxisAlignment.center,
                      children: [
                        // 3D Parlayan Canlı Balon Gövdesi
                        Stack(
                          clipBehavior: Clip.none,
                          alignment: Alignment.center,
                          children: [
                            Container(
                              width: 90,
                              height: 110,
                              decoration: BoxDecoration(
                                gradient: RadialGradient(
                                  center: const Alignment(-0.35, -0.45),
                                  radius: 0.95,
                                  colors: [
                                    Color.lerp(color, Colors.white, 0.45)!,
                                    color,
                                    Color.lerp(color, Colors.black, 0.25)!,
                                  ],
                                ),
                                borderRadius: BorderRadius.circular(55),
                                boxShadow: [
                                  BoxShadow(
                                    color: color.withValues(alpha: 0.4),
                                    blurRadius: 14,
                                    offset: const Offset(0, 8),
                                  ),
                                ],
                              ),
                              child: const Center(
                                child: Text("🎈", style: TextStyle(fontSize: 32)),
                              ),
                            ),
                            // Işık Yansıması Parlaması
                            Positioned(
                              top: 14,
                              left: 18,
                              child: Container(
                                width: 16,
                                height: 9,
                                decoration: BoxDecoration(
                                  color: Colors.white.withValues(alpha: 0.7),
                                  borderRadius: BorderRadius.circular(10),
                                ),
                              ),
                            ),
                            // Balon Düğümü
                            Positioned(
                              bottom: -4,
                              child: Container(
                                width: 10,
                                height: 6,
                                decoration: BoxDecoration(
                                  color: color,
                                  borderRadius: BorderRadius.circular(3),
                                ),
                              ),
                            ),
                          ],
                        ),
                        // Balon İpi
                        Container(width: 2, height: 26, color: Colors.grey.shade400),
                        // İngilizce Metin Kartı (Okunabilir, Ferah Rozet)
                        Container(
                          margin: const EdgeInsets.symmetric(horizontal: 4),
                          padding: const EdgeInsets.symmetric(horizontal: 10, vertical: 8),
                          decoration: BoxDecoration(
                            color: Colors.white,
                            borderRadius: BorderRadius.circular(16),
                            border: Border.all(color: color.withValues(alpha: 0.6), width: 2),
                            boxShadow: [
                              BoxShadow(
                                color: Colors.black.withValues(alpha: 0.06),
                                blurRadius: 6,
                                offset: const Offset(0, 2),
                              )
                            ],
                          ),
                          child: Text(
                            opt,
                            textAlign: TextAlign.center,
                            maxLines: 2,
                            overflow: TextOverflow.ellipsis,
                            style: const TextStyle(
                              fontSize: 13,
                              fontWeight: FontWeight.w900,
                              color: Color(0xFF263238),
                            ),
                          ),
                        ),
                      ],
                    ),
                  ),
                ),
              );
            }),
          ),
        ),
      ],
    );
  }

  // -------------------------------------------------------------------------
  // 5. CÜMLE KURMA (SENTENCE BUILDER)
  // -------------------------------------------------------------------------
  Widget _buildSentenceBuilderGame() {
    final sentences = widget.activity.gameData['sentences'] as List<dynamic>;
    final currentItem = sentences[_currentStepIndex];
    final allWords = List<String>.from(currentItem['words'])..addAll(List<String>.from(currentItem['distractors']));

    return Column(
      children: [
        Container(
          padding: const EdgeInsets.symmetric(horizontal: 18, vertical: 12),
          decoration: BoxDecoration(
            color: Colors.white,
            borderRadius: BorderRadius.circular(18),
            border: Border.all(color: Colors.purple.shade200, width: 2),
          ),
          child: Row(
            mainAxisSize: MainAxisSize.min,
            children: [
              Text(currentItem['icon'] ?? '🧩', style: const TextStyle(fontSize: 28)),
              const SizedBox(width: 10),
              const Text(
                "Build the sentence! 🧩",
                style: TextStyle(fontSize: 16, fontWeight: FontWeight.bold, color: Color(0xFF4A148C)),
              ),
            ],
          ),
        ),
        const SizedBox(height: 16),

        // Cümle dizim yuvası
        Container(
          width: double.infinity,
          constraints: const BoxConstraints(minHeight: 70),
          padding: const EdgeInsets.all(12),
          decoration: BoxDecoration(
            color: Colors.purple.shade50,
            borderRadius: BorderRadius.circular(18),
            border: Border.all(color: Colors.purple.shade300, width: 2),
          ),
          child: Wrap(
            spacing: 8,
            runSpacing: 8,
            children: _builtWords.map((w) {
              return GestureDetector(
                onTap: () {
                  setState(() => _builtWords.remove(w));
                },
                child: Container(
                  padding: const EdgeInsets.symmetric(horizontal: 12, vertical: 8),
                  decoration: BoxDecoration(
                    color: Colors.amber.shade300,
                    borderRadius: BorderRadius.circular(12),
                    border: Border.all(color: Colors.amber.shade700, width: 2),
                  ),
                  child: Text(w, style: const TextStyle(fontWeight: FontWeight.w900, fontSize: 15)),
                ),
              );
            }).toList(),
          ),
        ),
        const SizedBox(height: 18),

        // Kelime Taşları
        Wrap(
          spacing: 8,
          runSpacing: 8,
          children: allWords.where((w) => !_builtWords.contains(w)).map((word) {
            return GestureDetector(
              onTap: () {
                SoundService().speakEnglish(word);
                setState(() => _builtWords.add(word));
              },
              child: Container(
                padding: const EdgeInsets.symmetric(horizontal: 14, vertical: 10),
                decoration: BoxDecoration(
                  color: Colors.white,
                  borderRadius: BorderRadius.circular(14),
                  border: Border.all(color: Colors.grey.shade300, width: 2),
                ),
                child: Text(word, style: const TextStyle(fontSize: 15, fontWeight: FontWeight.bold)),
              ),
            );
          }).toList(),
        ),

        const Spacer(),
        BouncyButton(
          text: 'KONTROL ET ✔️',
          color: Colors.green,
          shadowColor: Colors.green.shade800,
          isActive: _builtWords.isNotEmpty,
          onPressed: () {
            final formedSentence = _builtWords.join(' ');
            if (formedSentence == currentItem['correct']) {
              SoundService().speakEnglish(formedSentence);
              setState(() {
                _characterFeedback = "Kusursuz bir cümle kurdun! 🌟";
                _builtWords.clear();
                if (_currentStepIndex < sentences.length - 1) {
                  _currentStepIndex++;
                } else {
                  _triggerSuccess();
                }
              });
            } else {
              setState(() {
                _characterFeedback = "Kelimelerin sırasını tekrar dene! 🧩";
                context.read<AppState>().useHeart();
              });
            }
          },
        ),
      ],
    );
  }

  // -------------------------------------------------------------------------
  // 6. HARF ÇİZME / TRACE
  // -------------------------------------------------------------------------
  Widget _buildTraceGame() {
    final letters = widget.activity.gameData['letters'] as List<dynamic>;
    final currentLetterItem = letters[_currentStepIndex];

    return Column(
      children: [
        Row(
          mainAxisAlignment: MainAxisAlignment.center,
          children: [
            Text(currentLetterItem['icon'], style: const TextStyle(fontSize: 28)),
            const SizedBox(width: 8),
            Text(
              "${currentLetterItem['word']}",
              style: const TextStyle(fontSize: 22, fontWeight: FontWeight.w900, color: Color(0xFF4A148C)),
            ),
          ],
        ),
        const SizedBox(height: 10),

        Expanded(
          child: Container(
            width: double.infinity,
            margin: const EdgeInsets.all(8),
            decoration: BoxDecoration(
              color: Colors.white,
              borderRadius: BorderRadius.circular(24),
              border: Border.all(color: Colors.purple.shade200, width: 2.5),
            ),
            child: GestureDetector(
              onPanUpdate: (details) {
                RenderBox renderBox = context.findRenderObject() as RenderBox;
                setState(() {
                  _tracePoints.add(renderBox.globalToLocal(details.globalPosition));
                  if (_tracePoints.length > 20 && !_isLetterCompleted) {
                    _isLetterCompleted = true;
                    _characterFeedback = "Süper çizdin! ${currentLetterItem['word']} kelimesini öğrendin!";
                    SoundService().speakEnglish(currentLetterItem['word'] as String);
                  }
                });
              },
              onPanEnd: (details) {
                _tracePoints.add(null);
              },
              child: Stack(
                alignment: Alignment.center,
                children: [
                  Text(
                    currentLetterItem['letter'],
                    style: TextStyle(
                      fontSize: 160,
                      fontWeight: FontWeight.w900,
                      color: _isLetterCompleted ? Colors.green.shade400 : Colors.grey.shade200,
                    ),
                  ),
                  CustomPaint(
                    painter: _DrawingPainter(points: _tracePoints),
                    size: Size.infinite,
                  ),
                ],
              ),
            ),
          ),
        ),

        if (_isLetterCompleted)
          Padding(
            padding: const EdgeInsets.all(8.0),
            child: BouncyButton(
              text: _currentStepIndex < letters.length - 1 ? 'SONRAKİ HARF ➡️' : 'TAMAMLA 🎉',
              color: Colors.purple,
              shadowColor: Colors.purple.shade800,
              isActive: true,
              onPressed: () {
                setState(() {
                  if (_currentStepIndex < letters.length - 1) {
                    _currentStepIndex++;
                    _tracePoints.clear();
                    _isLetterCompleted = false;
                  } else {
                    _triggerSuccess();
                  }
                });
              },
            ),
          ),
      ],
    );
  }

  // -------------------------------------------------------------------------
  // 7. HAFIZA KARTLARI (MEMORY)
  // -------------------------------------------------------------------------
  Widget _buildMemoryGame() {
    final cards = widget.activity.gameData['cards'] as List<dynamic>;

    return GridView.builder(
      gridDelegate: const SliverGridDelegateWithFixedCrossAxisCount(
        crossAxisCount: 2,
        childAspectRatio: 1.6,
        crossAxisSpacing: 10,
        mainAxisSpacing: 10,
      ),
      itemCount: cards.length,
      itemBuilder: (context, index) {
        final card = cards[index];
        final isFlipped = _flippedIndices.contains(index) || _matchedIndices.contains(index);

        return GestureDetector(
          onTap: isFlipped ? null : () => _handleCardFlip(index, card['pairId']),
          child: AnimatedContainer(
            duration: const Duration(milliseconds: 250),
            decoration: BoxDecoration(
              color: isFlipped ? Colors.white : const Color(0xFF673AB7),
              borderRadius: BorderRadius.circular(16),
              border: Border.all(
                color: isFlipped ? Colors.purple.shade300 : Colors.purple.shade900,
                width: 2,
              ),
            ),
            child: Center(
              child: isFlipped
                  ? Text(
                      card['text'],
                      textAlign: TextAlign.center,
                      style: const TextStyle(fontSize: 14, fontWeight: FontWeight.w900, color: Color(0xFF4A148C)),
                    )
                  : const Text("❓", style: TextStyle(fontSize: 28)),
            ),
          ),
        );
      },
    );
  }

  void _handleCardFlip(int index, int pairId) {
    if (_flippedIndices.length >= 2) return;

    setState(() {
      _flippedIndices.add(index);

      if (_flippedIndices.length == 2) {
        final cards = widget.activity.gameData['cards'] as List<dynamic>;
        final firstCard = cards[_flippedIndices[0]];
        final secondCard = cards[_flippedIndices[1]];

        if (firstCard['pairId'] == secondCard['pairId']) {
          _matchedIndices.addAll(_flippedIndices);
          _flippedIndices.clear();
          _characterFeedback = "Great memory! Cards matched! 🃏✨";
          SoundService().speakEnglish("Matched!");

          if (_matchedIndices.length == cards.length) {
            _triggerSuccess();
          }
        } else {
          Future.delayed(const Duration(milliseconds: 800), () {
            if (mounted) {
              setState(() {
                _flippedIndices.clear();
                _characterFeedback = "Tekrar dene, yerlerini aklında tut! 🤔";
              });
            }
          });
        }
      }
    });
  }

  // -------------------------------------------------------------------------
  // 8. GİZLİ NESNE (HIDDEN OBJECT)
  // -------------------------------------------------------------------------
  Widget _buildHiddenObjectGame() {
    final objects = widget.activity.gameData['objects'] as List<dynamic>;

    return Column(
      children: [
        const Text(
          "Odadaki nesnelere dokunarak Alex'i tanıyalım! 🔍",
          style: TextStyle(fontSize: 15, fontWeight: FontWeight.bold, color: Colors.purple),
        ),
        const SizedBox(height: 12),

        Expanded(
          child: Container(
            width: double.infinity,
            padding: const EdgeInsets.all(16),
            decoration: BoxDecoration(
              color: const Color(0xFFE1F5FE),
              borderRadius: BorderRadius.circular(24),
              border: Border.all(color: Colors.lightBlue.shade300, width: 2.5),
            ),
            child: Wrap(
              alignment: WrapAlignment.spaceEvenly,
              runSpacing: 18,
              spacing: 18,
              children: List.generate(objects.length, (index) {
                final obj = objects[index];
                final isFound = _foundObjects.contains(index);

                return GestureDetector(
                  onTap: () {
                    SoundService().speakEnglish(obj['sentence'] as String);
                    setState(() {
                      _foundObjects.add(index);
                      _characterFeedback = obj['sentence'] as String;
                      if (_foundObjects.length == objects.length) {
                        _triggerSuccess();
                      }
                    });
                  },
                  child: AnimatedContainer(
                    duration: const Duration(milliseconds: 200),
                    padding: const EdgeInsets.all(14),
                    decoration: BoxDecoration(
                      color: isFound ? Colors.green.shade100 : Colors.white,
                      borderRadius: BorderRadius.circular(20),
                      border: Border.all(color: isFound ? Colors.green : Colors.lightBlue, width: 2.5),
                    ),
                    child: Column(
                      children: [
                        Text(obj['icon'], style: const TextStyle(fontSize: 38)),
                        const SizedBox(height: 6),
                        Text(
                          isFound ? obj['sentence'] : '???',
                          style: TextStyle(
                            fontSize: 13,
                            fontWeight: FontWeight.bold,
                            color: isFound ? Colors.green.shade900 : Colors.grey,
                          ),
                        ),
                      ],
                    ),
                  ),
                );
              }),
            ),
          ),
        ),
      ],
    );
  }

  // -------------------------------------------------------------------------
  // 9. BOŞLUK DOLDURMA (FILL IN THE BLANK)
  // -------------------------------------------------------------------------
  Widget _buildFillBlankGame() {
    final questions = widget.activity.gameData['questions'] as List<dynamic>;
    final currentQ = questions[_currentStepIndex];
    final options = currentQ['options'] as List<dynamic>;

    return Column(
      children: [
        const SizedBox(height: 16),
        Container(
          padding: const EdgeInsets.all(20),
          decoration: BoxDecoration(
            color: Colors.white,
            borderRadius: BorderRadius.circular(20),
            border: Border.all(color: Colors.purple.shade200, width: 2),
          ),
          child: Column(
            children: [
              Text(
                currentQ['sentence'],
                style: const TextStyle(fontSize: 20, fontWeight: FontWeight.w900, color: Color(0xFF4A148C)),
                textAlign: TextAlign.center,
              ),
            ],
          ),
        ),
        const SizedBox(height: 24),

        Column(
          children: options.map((opt) {
            return Container(
              margin: const EdgeInsets.only(bottom: 10),
              width: double.infinity,
              child: BouncyButton(
                text: opt,
                color: Colors.orange.shade400,
                shadowColor: Colors.orange.shade700,
                isActive: true,
                onPressed: () {
                  SoundService().speakEnglish(opt);
                  setState(() {
                    if (opt == currentQ['answer']) {
                      _characterFeedback = "You completed it correctly! 🔤";
                      SoundService().speakEnglish("Congratulations!");
                      if (_currentStepIndex < questions.length - 1) {
                        _currentStepIndex++;
                      } else {
                        _triggerSuccess();
                      }
                    } else {
                      _characterFeedback = "Try another word! 🤔";
                      context.read<AppState>().useHeart();
                    }
                  });
                },
              ),
            );
          }).toList(),
        ),
      ],
    );
  }

  // -------------------------------------------------------------------------
  // 10. KONUŞ VE KAYDET (SPEAK & RECORD)
  // -------------------------------------------------------------------------
  Widget _buildSpeakRecordGame() {
    final prompts = widget.activity.gameData['prompts'] as List<dynamic>;
    final currentPrompt = prompts[_currentStepIndex];

    return Column(
      children: [
        const SizedBox(height: 10),
        Container(
          padding: const EdgeInsets.all(18),
          decoration: BoxDecoration(
            color: Colors.white,
            borderRadius: BorderRadius.circular(20),
            border: Border.all(color: Colors.purple.shade200, width: 2),
          ),
          child: Column(
            children: [
              Text(
                currentPrompt['question'],
                style: const TextStyle(fontSize: 20, fontWeight: FontWeight.w900, color: Color(0xFF4A148C)),
                textAlign: TextAlign.center,
              ),
              const SizedBox(height: 10),
              GestureDetector(
                onTap: () {
                  SoundService().speakEnglish(currentPrompt['suggested'] as String);
                },
                child: Container(
                  padding: const EdgeInsets.all(10),
                  decoration: BoxDecoration(
                    color: Colors.green.shade50,
                    borderRadius: BorderRadius.circular(12),
                  ),
                  child: Row(
                    mainAxisSize: MainAxisSize.min,
                    children: [
                      const Icon(Icons.volume_up_rounded, color: Colors.green, size: 20),
                      const SizedBox(width: 6),
                      Flexible(
                        child: Text(
                          "Example: \"${currentPrompt['suggested']}\"",
                          style: TextStyle(fontSize: 13, color: Colors.green.shade900, fontWeight: FontWeight.w600),
                        ),
                      ),
                    ],
                  ),
                ),
              ),
            ],
          ),
        ),
        const Spacer(),

        GestureDetector(
          onTap: () {
            setState(() {
              _isRecording = true;
              _characterFeedback = "Listening... Speak in English! 🎙️";
            });

            Future.delayed(const Duration(seconds: 2), () {
              if (mounted) {
                setState(() {
                  _isRecording = false;
                  _characterFeedback = "Great speech! Beautiful pronunciation! 🎙️🌟";
                  SoundService().speakEnglish("Great pronunciation!");
                  if (_currentStepIndex < prompts.length - 1) {
                    _currentStepIndex++;
                  } else {
                    _triggerSuccess();
                  }
                });
              }
            });
          },
          child: AnimatedContainer(
            duration: const Duration(milliseconds: 250),
            width: 100,
            height: 100,
            decoration: BoxDecoration(
              color: _isRecording ? Colors.redAccent : Colors.purple,
              shape: BoxShape.circle,
              boxShadow: [
                BoxShadow(
                  color: (_isRecording ? Colors.redAccent : Colors.purple).withValues(alpha: 0.35),
                  blurRadius: 16,
                  spreadRadius: 3,
                ),
              ],
            ),
            child: Icon(
              _isRecording ? Icons.mic_rounded : Icons.mic_none_rounded,
              color: Colors.white,
              size: 50,
            ),
          ),
        ),
        const SizedBox(height: 14),
        Text(
          _isRecording ? "KAYDEDİLİYOR... 🔴" : "DOKUN VE İNGİLİZCE KONUŞ 🎙️",
          style: const TextStyle(fontSize: 14, fontWeight: FontWeight.w900, color: Colors.black87),
        ),
        const Spacer(),
      ],
    );
  }
}

// Harf Çizim Painter (Hafif ve Performanslı)
class _DrawingPainter extends CustomPainter {
  final List<Offset?> points;

  _DrawingPainter({required this.points});

  @override
  void paint(Canvas canvas, Size size) {
    Paint paint = Paint()
      ..color = Colors.orangeAccent
      ..strokeCap = StrokeCap.round
      ..strokeWidth = 12.0;

    for (int i = 0; i < points.length - 1; i++) {
      if (points[i] != null && points[i + 1] != null) {
        canvas.drawLine(points[i]!, points[i + 1]!, paint);
      }
    }
  }

  @override
  bool shouldRepaint(covariant _DrawingPainter oldDelegate) => true;
}
